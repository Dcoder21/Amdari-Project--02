# SentinelPay environment variables — copy this to .env for local dev.
# .env is git-ignored; never commit real values here or anywhere else.
#
# Fix for V-CLD-04: this file previously contained the actual AWS example
# credentials, a DB password, and a JWT secret inline — fine as long as
# they're placeholders, but it normalises pasting a real value into a
# tracked file. Everything below is a placeholder to replace, not a value
# to use as-is.

POSTGRES_PASSWORD=replace-with-a-local-dev-password
DATABASE_URL=postgresql://sentinel:replace-with-a-local-dev-password@postgres:5432/sentinelpay
REDIS_URL=redis://redis:6379/0

# JWT_PRIVATE_KEY_B64 / JWT_PUBLIC_KEY_B64 are generated by
# scripts/generate_dev_jwt_keys.sh, not set here by hand.

# moto mocks S3 in tests, so these never reach a real AWS account in this
# environment — but treat them as real credentials anyway, since a real
# deployment would use real ones here.
AWS_ACCESS_KEY_ID=replace-with-your-own-dev-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-own-dev-secret-key
AWS_REGION=af-south-1

KYC_BUCKET=sentinelpay-kyc-documents
WEBHOOK_TIMEOUT=10
ENVIRONMENT=development
